---
// Persistent sidebar (outside [data-page], never re-rendered on navigation). player.ts
// marks the current page's link (.active) and the playing speaker/genre (.current,
// .playing with equalizer bars).
import '../styles/Sidebar.scss';
import { speakers, music, speakerUrl, genreUrl } from '../lib/data';
import { SITE_NAME, FOUNDED_YEAR } from '../lib/site';
---

<div class="Sidebar animated slideInLeft" transition:persist="sidebar">
  <h2><a href="/">{SITE_NAME}</a></h2>
  <!-- Phones only: the sidebar is a 50px top bar; this opens it as a full-screen menu (script below). -->
  <button type="button" class="menu-toggle" data-menu-toggle aria-label="Open menu" aria-expanded="false">
    <i class="fa fa-bars" aria-hidden="true"></i>
  </button>
  <nav class="primary">
    <a class="link" href="/" data-nav-link>
      <i class="fa fa-home" aria-hidden="true"></i>
      <span class="name">Home</span>
    </a>
    <button type="button" class="link" data-random>
      <i class="fa fa-random" aria-hidden="true"></i>
      <span class="name">Random</span>
    </button>
  </nav>

  <span class="title">Speakers</span>
  {Object.entries(speakers).map(([key, speaker]) => (
    <a class="link" href={speakerUrl(key)} data-nav-link data-side-speaker={key}>
      <span class="name">{speaker.name}</span>
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </a>
  ))}

  <!-- Hidden on phones, which can't play music under a lecture (see product.md, "On phones"). -->
  <span class="title" data-side-music>Music</span>
  {Object.entries(music).map(([key, genre]) => (
    <a class="link" href={genreUrl(key)} data-nav-link data-side-genre={key}>
      <span class="name">{genre.name}</span>
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </a>
  ))}

  <!-- Pinned to the bottom of the sidebar while the links above scroll (Sidebar.scss). -->
  <div class="bottom">
    <!-- Donations via Buy Me a Coffee (opens in a new tab). -->
    <div class="donate">
      <a href="https://buymeacoffee.com/jadeallencook" target="_blank" rel="noopener noreferrer">
        <i class="fa fa-heart" aria-hidden="true"></i>
        Support {SITE_NAME}
      </a>
    </div>

    <span class="footer"><b>{SITE_NAME}</b> {FOUNDED_YEAR}-{new Date().getFullYear()}</span>
    <span class="footer">
      Developed By <b><a href="https://github.com/jadeallencook" rel="noopener noreferrer" target="_blank">@jadeallencook</a></b>
    </span>
  </div>
</div>

<script>
  // Phones: open/close the full-screen menu (Sidebar.scss, `.menu-open`). The sidebar is
  // persisted across navigation, so this runs once. Choosing a link, Random, Escape or any
  // navigation closes it. It opens at the top of the list, and closing waits for the
  // close animation (200ms, matching menu-out) before collapsing back to the top bar.
  const sidebar = document.querySelector<HTMLElement>('.Sidebar');
  const toggle = sidebar?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  if (sidebar && toggle) {
    let closing = 0;
    const setMenu = (open: boolean) => {
      const isOpen = sidebar.classList.contains('menu-open') && !sidebar.classList.contains('menu-closing');
      if (isOpen === open) return;
      window.clearTimeout(closing);
      document.documentElement.classList.toggle('menu-lock', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.querySelector('i')?.classList.toggle('fa-bars', !open);
      toggle.querySelector('i')?.classList.toggle('fa-times', open);
      if (open) {
        sidebar.classList.remove('menu-closing');
        sidebar.classList.add('menu-open');
        // Always start at the top of the list.
        sidebar.scrollTop = 0;
      } else {
        // Play the close animation (menu-out in Sidebar.scss), then collapse back to the bar.
        sidebar.classList.add('menu-closing');
        closing = window.setTimeout(() => sidebar.classList.remove('menu-open', 'menu-closing'), 200);
      }
    };
    toggle.addEventListener('click', () => setMenu(!sidebar.classList.contains('menu-open')));
    sidebar.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a, [data-random]')) setMenu(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setMenu(false);
    });
    document.addEventListener('astro:after-swap', () => setMenu(false));
  }
</script>
