---
// Dev server only (imported dynamically in Layout.astro, like EditorTools, so production
// builds never include it). Lists content problems that would fail `npm run build`, so a
// bad edit shows up here instead of crashing the dev server. Styles are inline (no
// bundled <style>) for the same reason; they also style the rows Songs.astro marks.
import { findDuplicateTitles, speakerUrl, genreUrl } from '../lib/data';

const duplicates = findDuplicateTitles();
---

{duplicates.length > 0 && (
  <aside class="dev-warnings" role="alert">
    <button type="button" class="close" aria-label="Hide until the next page" onclick="this.parentElement.remove()">×</button>
    <strong>
      <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
      Duplicate titles: <code>npm run build</code> fails until each is deleted or renamed (then reload)
    </strong>
    <ul>
      {duplicates.map((d) => (
        <li>
          <a href={d.kind === 'speaker' ? speakerUrl(d.slug) : genreUrl(d.slug)}>{d.name}</a>: "{d.title}", rows{' '}
          {d.videos.map((v) => `#${v.position}`).join(' and ')}
        </li>
      ))}
    </ul>
  </aside>
)}

<style is:inline>
  /* Fixed over the content area (pages are absolutely positioned scroll boxes). */
  .dev-warnings {
    position: fixed;
    z-index: 5;
    top: 12px;
    left: 220px;
    right: 150px; /* clear of the "Edit mode" badge */
    box-sizing: border-box;
    padding: 12px 40px 12px 16px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    border: 1px solid #e0a040;
    border-radius: 8px;
    background-color: rgba(60, 44, 20, 0.92);
    color: #f3d9a8;
    font-size: 0.85em;
    line-height: 1.5;
  }
  .dev-warnings .close {
    position: absolute;
    top: 6px;
    right: 8px;
    border: none;
    background: none;
    color: #f3d9a8;
    font-size: 1.4em;
    line-height: 1;
    cursor: pointer;
  }
  @media only screen and (max-device-width: 480px) {
    .dev-warnings {
      top: 60px;
      left: 12px;
      right: 12px;
    }
  }
  .dev-warnings strong i {
    margin-right: 6px;
  }
  .dev-warnings code {
    color: #fff;
  }
  .dev-warnings ul {
    margin: 6px 0 0 0;
    padding-left: 20px;
  }
  .dev-warnings a {
    color: #fff;
    font-weight: bold;
  }
  .Songs .song.duplicate {
    box-shadow: inset 3px 0 0 #e0a040;
  }
  .Songs .song .dup-tag {
    flex-shrink: 0;
    margin: 0 10px;
    padding: 2px 8px;
    border-radius: 999px;
    background-color: rgba(224, 160, 64, 0.18);
    color: #f3d9a8;
    font-size: 0.72em;
    white-space: nowrap;
  }
</style>
