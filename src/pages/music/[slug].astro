---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Songs from '../../components/Songs.astro';
import { music } from '../../lib/data';
import { SITE_NAME } from '../../lib/site';

export const getStaticPaths = (() =>
  Object.keys(music).map((slug) => ({ params: { slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const genre = music[slug];
---

<Layout title={`${genre.name} | ${SITE_NAME}`} description={`${genre.name} background music for lectures on ${SITE_NAME}.`}>
  <Songs kind="music" slug={slug} collection={genre} />
</Layout>
